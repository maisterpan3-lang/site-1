                <script type="text/javascript">
                    start_timer();
                    var time = 600;
                    var intr;

                    function start_timer() {
                        intr = setInterval(tick, 1000);
                    }

                    function tick() {
                        time = time - 1;
                        var mins = Math.floor(time / 60);
                        var secs = time - mins * 60;
                        if (mins == 0 && secs == 0) {
                            clearInterval(intr);
                        }
                        secs = secs >= 10 ? secs : '0' + secs;
                        $('#min').html('0' + mins);
                        $('#sec').html(secs);
                    }
                </script>
