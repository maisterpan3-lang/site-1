        <script data-protect="false">
            try {
                document.documentElement.style.visibility = 'visible';
                document.body.style.visibility = 'visible';
            } catch (e) {}
            window.addEventListener('DOMContentLoaded', function() {
                try {
                    document.body.style.visibility = 'visible';
                } catch (e) {}
            });
        </script>
        <script>
            (function() {
                var quiz = document.querySelector('.qzc');
                if (!quiz)
                    return;

                var steps = ['qz-s1', 'qz-s2', 'qz-s3', 'qz-s4', 'qz-s5', 'qz-s6'];
                var checking = quiz.querySelector('.qz-checking');
                var result = quiz.querySelector('.qz-result');
                var chkItems = quiz.querySelectorAll('.qz-checking .qz-chk-item');
                var rtDefault = quiz.querySelector('.qz-rt-default');
                var orderZone = document.querySelector('center.qz-orderzone');
                var form = document.querySelector('div.pachinoform');

                function showStep(name) {
                    steps.forEach(function(s) {
                        var el = quiz.querySelector('.' + s);
                        if (el)
                            el.style.display = (s === name) ? 'block' : 'none';
                    });
                }

                function nextAfter(currentIndex) {
                    if (currentIndex < steps.length - 1) {
                        showStep(steps[currentIndex + 1]);
                    } else {
                        finishQuiz();
                    }
                }

                function finishQuiz() {
                    showStep(null);
                    checking.style.display = 'block';

                    chkItems.forEach(function(item, i) {
                        item.style.animation = 'none';
                        item.offsetHeight;
                        item.style.animationDelay = (i * 0.35) + 's';
                        item.style.animation = 'qzitem .3s forwards';
                    });

                    setTimeout(function() {
                        checking.style.display = 'none';
                        result.style.display = 'block';

                        if (rtDefault)
                            rtDefault.style.display = 'block';

                        // В CSS форма скрыта через display:none!important —
                        // обычный .style.display это не перебивает, нужен setProperty с 'important'
                        if (orderZone)
                            orderZone.style.setProperty('display', 'block', 'important');
                        if (form)
                            form.style.setProperty('display', 'flex', 'important');

                        var scrollTarget = orderZone || form;
                        if (scrollTarget) {
                            scrollTarget.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });
                        }
                    }, chkItems.length * 350 + 500);
                }

                steps.forEach(function(stepClass, index) {
                    var radios = quiz.querySelectorAll('.' + stepClass + ' input[type="radio"]');
                    radios.forEach(function(radio) {
                        radio.addEventListener('change', function() {
                            nextAfter(index);
                        });
                    });
                });

                showStep(steps[0]);
                if (orderZone)
                    orderZone.style.display = 'none';
                if (form)
                    form.style.display = 'none';
            }
            )();
        </script>
