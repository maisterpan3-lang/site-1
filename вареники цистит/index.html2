                <span class="head-main-date-title">Közzététel dátuma: </span>
                <span id="fiveDaysAgo">2026. július 04. 12:00</span>
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const now = new Date();
                        const base = new Date(now.getFullYear(),now.getMonth(),now.getDate(),12,0,0);
                        base.setDate(base.getDate() - 5);

                        const fmt = new Intl.DateTimeFormat('hu-HU',{
                            timeZone: 'Europe/Budapest',
                            day: '2-digit',
                            month: 'long',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });

                        document.getElementById('fiveDaysAgo').textContent = fmt.format(base);
                    });
                </script>
            </div>
