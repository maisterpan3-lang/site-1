            /* ============================================================================
 * CPARJA override — обёртка .iti не должна менять вид поля лендинга.
 * vendor задаёт `.iti{display:inline-block}` (поле сжимается по контенту →
 * перестаёт быть на всю ширину). Перебиваем !important; vendor-правила выше
 * идут БЕЗ !important, так что эти всегда выигрывают, на любом домене и для
 * клона формы. Меняешь поведение маски-обёртки — ТОЛЬКО здесь.
 * При обновлении intl-tel-input этот блок переноси заново в конец файла.
 * ========================================================================== */
            .iti {
                display: block !important;
                width: 100% !important;
            }

            .iti > input.iti__tel-input, .iti > input.iti__tel-input[type=tel], .iti > input.iti__tel-input[type=text] {
                width: 100% !important;
            }
        </style>
    
<!-- MOBILE COMPATIBILITY PATCH | preserves existing HTML/CSS/JS/structure -->
<style id="mobile-compatibility-patch">
  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  @media screen and (max-width: 767px) {
    html, body {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      overflow-x: hidden !important;
    }

    body {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    main, header, footer, section, article, aside, nav,
    .container, .wrapper, .content, .main, .page, .inner {
      max-width: 100% !important;
    }

    main {
      width: 100% !important;
      min-width: 0 !important;
    }

    /* Keep every existing image visible and contained on small screens. */
    main img,
    img.img-card,
    img.comments__item-avatar,
    img.comments__item-image,
    img.stat-footer-logo,
    #epic, #epic2,
    .cap-bold img {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      max-width: 100% !important;
      height: auto !important;
    }

    /* Do not let inline desktop widths push the page outside the viewport. */
    main > img,
    main .img-card,
    main .comments__item-image,
    main #epic,
    main #epic2 {
      width: 100% !important;
    }

    /* Preserve small logos/avatars instead of stretching them unnecessarily. */
    .comments__item-avatar {
      width: auto !important;
      max-width: 100% !important;
      object-fit: cover;
    }

    .stat-footer-logo {
      width: auto !important;
      max-width: 170px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }

    /* Prevent fixed/desktop-sized children from creating horizontal clipping. */
    main > *, main p, main h1, main h2, main h3, main h4,
    main ul, main ol, main blockquote, main form, main center,
    main table, main .table-block, main .table-unique1,
    .pachinoform, .qzc, .qz-point {
      max-width: 100% !important;
    }

    /* Tables remain intact; on narrow screens they can scroll horizontally instead of disappearing. */
    .table-block, .table-unique1 {
      width: 100% !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch;
    }

    .table-block table, .table-unique1 {
      max-width: none;
    }

    /* Keep popup content usable on phones without changing its desktop behavior. */
    #popup3 {
      width: calc(100% - 20px) !important;
      max-width: calc(100% - 20px) !important;
      height: auto !important;
      max-height: calc(100vh - 20px) !important;
      padding: 15px !important;
    }

    .qzc {
      width: calc(100% - 16px) !important;
      margin-left: 8px !important;
      margin-right: 8px !important;
    }

    /* Long words/URLs must wrap rather than force a horizontal page scroll. */
    main, main * {
      overflow-wrap: anywhere;
      word-break: normal;
    }
  }

  @media screen and (max-width: 460px) {
    .table-block h1 { font-size: 16px !important; }
    .table td, .table th { font-size: 15px !important; }
    .table td { padding: 6px 7px !important; }
    .table-block { border-width: 4px !important; }
    .qzc__head { padding-left: 14px !important; padding-right: 14px !important; }
  }
</style>

</head>
