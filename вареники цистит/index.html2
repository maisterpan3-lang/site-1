<script id="mobile-image-compatibility-patch">
(function () {
  function prepareImages() {
    var images = document.querySelectorAll('img');
    images.forEach(function (img) {
      /* Force native lazy images to be available on mobile as well. */
      img.loading = 'eager';
      img.decoding = 'async';

      /* If a saved/local image is missing, use the preserved original source. */
      if (!img.__mobileFallbackBound) {
        img.__mobileFallbackBound = true;
        img.addEventListener('error', function () {
          var original = img.getAttribute('data-original-src');
          var current = img.getAttribute('src');
          if (original && original !== current && !img.__triedOriginalSource) {
            img.__triedOriginalSource = true;
            img.src = original;
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', prepareImages);
  } else {
    prepareImages();
  }
  window.addEventListener('load', prepareImages);
})();
</script>

