                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function() {
                        class Reservation {
                            constructor() {
                                this.checkReservation();
                            }

                            getRandomNumber(min, max) {
                                return Math.floor(Math.random() * (max - min + 1)) + min;
                            }

                            formatNumber(number) {
                                return number.toLocaleString('ru-RU');
                                // Разделение числа пробелами
                            }

                            checkReservation() {
                                let reservedPlace;
                                if (!sessionStorage.getItem('reserved')) {
                                    reservedPlace = this.getRandomNumber(19953, 19964);
                                    sessionStorage.setItem('reserved', 'true');
                                } else {
                                    reservedPlace = this.getRandomNumber(19973, 19993);
                                }

                                const numberElements = document.querySelectorAll('.number-me');
                                // Получаем все элементы с классом .number-me
                                if (numberElements.length > 0) {
                                    numberElements.forEach( (element) => {
                                        element.textContent = this.formatNumber(reservedPlace);
                                        // Подставляем отформатированное число во все элементы
                                    }
                                    );
                                }
                            }
                        }

                        new Reservation();
                    });
                </script>
                <script>
                    const leftPack = $('.left-pack');
                    let countt = sessionStorage.getItem('leftPack') ? Number(sessionStorage.getItem('leftPack')) : 43;

                    function randomInteger(min, max) {
                        let rand = min - 0.5 + Math.random() * (max - min + 1);
                        return Math.round(rand);
                    }

                    function init(countt) {
                        if (countt > 5) {
                            leftPack.html(countt);
                            sessionStorage.setItem('leftPack', countt);
                        } else {
                            leftPack.html(9);
                        }
                    }

                    init(countt);

                    function decrement() {
                        if (countt > 5) {
                            countt -= randomInteger(1, 2);
                            init(countt);
                            const randomTime = randomInteger(13000, 56000);
                            setTimeout(decrement, randomTime);
                        }
                    }

                    decrement();
                </script>
